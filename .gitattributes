# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gz binary
*.pt binary
